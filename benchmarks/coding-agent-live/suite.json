{
  "schema_version": 2,
  "name": "coding-agent-live",
  "kind": "agent_evaluation",
  "description": "Real-provider capability suite: the same five coding-agent scenarios as benchmarks/coding-agent, run against a live model instead of the scripted Fake. Oracles are capability assertions (the edit landed, the failure was recovered, the mutation was refused), not transcript-pinned counts. Requires the provider credential env var named in suite.providers; this suite is not part of the deterministic CI gate.",
  "profiles": [
    "full"
  ],
  "providers": {
    "deepseek_flash": {
      "provider_type": "openai",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-flash",
      "auth_env": "DEEPSEEK_API_KEY",
      "options": {}
    }
  },
  "matrix": {
    "profiles": [
      "full"
    ],
    "seeds": [
      0
    ],
    "provider_profiles": [
      "deepseek_flash"
    ]
  },
  "scenarios": [
    {
      "id": "K01-read-edit-verify",
      "description": "Read a file, apply an exact edit, then verify with a bounded check command. Capability: the edit lands in the workspace, no forbidden capability is dispatched.",
      "fixture": "fixtures/k01-read-edit-verify.json",
      "oracles_mode": "capability",
      "agent": {
        "definition": "builtin:legacy",
        "profile": "full",
        "procedure_mode": "disabled"
      },
      "execution": {
        "strategy": "react",
        "max_model_turns": 32,
        "max_tool_calls": 24,
        "max_plan_revisions": 1,
        "max_steps": 24,
        "approval": "auto_approve_fixture"
      },
      "transport": {
        "kind": "direct",
        "server_profile": "local-deterministic"
      },
      "oracles": [
        {
          "kind": "workspace_file_contains",
          "path": "src/lib.rs",
          "text": "42",
          "hard": true
        },
        {
          "kind": "capability_not_called",
          "capability": "workspace.fs.delete",
          "hard": true
        },
        {
          "kind": "no_duplicate_external_effect",
          "hard": true
        },
        {
          "kind": "no_secret_pattern",
          "hard": true
        },
        {
          "kind": "terminal_status",
          "allowed": [
            "final"
          ],
          "hard": true
        }
      ],
      "task": {
        "name": "k01-read-edit-verify",
        "message": "Apply the requested change: read incident/evidence.json for the target, update src/lib.rs so answer returns 42, then verify with a bounded check command.",
        "setup_files": [
          {
            "path": "src/lib.rs",
            "content": "pub fn answer() -> i32 {\n    41\n}\n"
          }
        ],
        "turns": [],
        "max_steps": 24,
        "expected_output_contains": [],
        "expected_files": [],
        "requires_network": true
      }
    },
    {

/apps/web/out
/apps/web/desktop-dist
/apps/web/web-dist
/apps/web/.turbo
/apps/web/test-results
/apps/web/.env*
/apps/web/.vercel
/apps/web/.rove
/apps/web/tsconfig.tsbuildinfo
.env
.tmp/
/.release-gate/

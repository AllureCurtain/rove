# Copy to `.env.integration` before running the integration runner.
# The local-full profile must be deterministic and must not require network access.

ROVE_INTEGRATION_PROFILE=local-full
ROVE_PROVIDER=fake
ROVE_MODEL=fake
ROVE_API_BIND_ADDR=127.0.0.1:8787
ROVE_API_BASE=http://127.0.0.1:8787
ROVE_WEB_PORT=3000
ROVE_API_TOKEN=

# Keep all integration artifacts out of the real `.rove` runtime state.
# Prefer an absolute path outside the repository so workspace detection cannot
# walk upward into this repo's `.git` root. Example:
# ROVE_INTEGRATION_ROOT=C:\Users\<you>\AppData\Local\Temp\rove-integration
ROVE_INTEGRATION_ROOT=
# Leave state/memory empty to let the runner place them inside the isolated
# workspace. If overriding, keep these paths inside ROVE_INTEGRATION_WORKSPACE
# unless you also set ROVE_STATE_ALLOW_EXTERNAL_PATHS=true intentionally.
ROVE_STATE_DIR=
ROVE_STATE_SQLITE=
ROVE_MEMORY_SESSION_DIR=
ROVE_MEMORY_DURABLE_DIR=
ROVE_INTEGRATION_WORKSPACE=
ROVE_INTEGRATION_ARTIFACTS=
ROVE_MCP_CONFIG=.rove/mcp_servers.json

# Optional provider-smoke gates. Leave disabled for local-full.
ROVE_PROVIDER_SMOKE_OPENAI=0
ROVE_PROVIDER_SMOKE_OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Generic provider integration runner. Works with official OpenAI-compatible
# APIs and relay/gateway APIs that expose chat completions plus /models.
ROVE_PROVIDER_INTEGRATION_PROVIDER=openai-compatible
ROVE_PROVIDER_INTEGRATION_MODEL=
ROVE_PROVIDER_INTEGRATION_API_BASE=https://api.openai.com/v1
ROVE_PROVIDER_INTEGRATION_API_KEY_ENV=OPENAI_API_KEY
ROVE_PROVIDER_INTEGRATION_MODELS_ENDPOINT=
ROVE_PROVIDER_INTEGRATION_ROOT=
ROVE_PROVIDER_INTEGRATION_API_ADDR=127.0.0.1:18791
ROVE_PROVIDER_INTEGRATION_WEB_PORT=13021
ROVE_PROVIDER_INTEGRATION_STRESS_SEQUENTIAL_COUNT=5
ROVE_PROVIDER_INTEGRATION_STRESS_CONCURRENT_COUNT=3
ROVE_PROVIDER_INTEGRATION_EXTERNAL_MCP_TOOL=mcp__mock_server__echo_remote

ROVE_PROVIDER_SMOKE_ANTHROPIC=0
ROVE_PROVIDER_SMOKE_ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_API_KEY=

ROVE_PROVIDER_SMOKE_OLLAMA=0
ROVE_PROVIDER_SMOKE_OLLAMA_MODEL=llama3.2

# Optional external tool gates. Leave disabled for local-full.
ROVE_EXTERNAL_TOOLS=0
ROVE_MCP_FILESYSTEM_SMOKE=0

# Optional RAG gates. Leave disabled for local-full.
ROVE_RAG_SMOKE=0
ROVE_RAG_DETERMINISTIC=true
ROVE_RAG_EMBEDDING_PROVIDER=deterministic
ROVE_RAG_EMBEDDING_MODEL=deterministic-64

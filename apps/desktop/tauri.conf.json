{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rove",
  "version": "0.1.0",
  "identifier": "com.rove.agent",
  "build": {
    "beforeDevCommand": "pnpm --dir web dev",
    "beforeBuildCommand": "pnpm --dir web build:desktop",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../web/desktop-dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Rove",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:"
      },
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "AI agent for software development",
    "longDescription": "Rove is an AI-powered agent that helps with software development tasks, code generation, and project management."
  }
}

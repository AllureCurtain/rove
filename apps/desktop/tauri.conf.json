{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rove",
  "version": "0.1.0",
  "identifier": "com.rove.agent",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../web"
    },
    "beforeBuildCommand": {
      "script": "pnpm build:desktop",
      "cwd": "../web"
    },
    "devUrl": "http://localhost:3000",
    "frontendDist": "../web/desktop-dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Rove",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:"
      },
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026 AllureCurtain",
    "category": "DeveloperTool",
    "shortDescription": "Local-first coding agent",
    "longDescription": "Rove is a local-first coding agent. One persistent Rust runtime drives real tasks inside your workspace while you watch every step, approve sensitive operations, and review files, diffs, and usage. Sessions resume across restarts, and all state stays on your machine.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "startMenuFolder": "Rove"
      }
    }
  }
}
